# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=facebook_live_products
DB_PORT=3306

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# QR Code Configuration (persisted here so it survives server restarts)
# QR_MODE: 'lan' or 'public'
QR_MODE=lan
# PUBLIC_URL: your ngrok / domain URL (leave blank for LAN-only)
PUBLIC_URL=
